{
  "uid": "fleet-hosts",
  "title": "Fleet hosts",
  "tags": ["fleet", "node-exporter", "php-fpm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "editable": false,
  "links": [],
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Hosts up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "cee3l7v6urpj4f" },
      "targets": [{ "refId": "A", "expr": "sum(up{job=\"node-exporter\"})" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Hosts down",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "cee3l7v6urpj4f" },
      "targets": [{ "refId": "A", "expr": "count(up{job=\"node-exporter\"} == 0) or vector(0)" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Pools queued",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "cee3l7v6urpj4f" },
      "targets": [{ "refId": "A", "expr": "count(phpfpm_listen_queue > 0) or vector(0)" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Soonest disk fill (days)",
      "description": "Only hosts whose root filesystem is shrinking. Blank means none are filling.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "cee3l7v6urpj4f" },
      "targets": [{
        "refId": "A",
        "expr": "(node_filesystem_avail_bytes{job=\"node-exporter\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"} / -deriv(node_filesystem_avail_bytes{job=\"node-exporter\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"}[6h])) / 86400 > 0"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 7 },
              { "color": "green", "value": 30 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["min"] } }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Highest load / CPU",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "cee3l7v6urpj4f" },
      "targets": [{
        "refId": "A",
        "expr": "max(node_load1{job=\"node-exporter\"} / count by (instance) (node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}))"
      }],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Days until root fills",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "cee3l7v6urpj4f" },
      "targets": [{
        "refId": "A",
        "legendFormat": "{{instance}}",
        "expr": "(node_filesystem_avail_bytes{job=\"node-exporter\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"} / -deriv(node_filesystem_avail_bytes{job=\"node-exporter\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"}[6h])) / 86400 > 0"
      }],
      "fieldConfig": { "defaults": { "unit": "d", "min": 0 }, "overrides": [] }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Load per CPU",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "cee3l7v6urpj4f" },
      "targets": [{
        "refId": "A",
        "legendFormat": "{{instance}}",
        "expr": "node_load1{job=\"node-exporter\"} / count by (instance) (node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"})"
      }],
      "fieldConfig": { "defaults": { "decimals": 2 }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory used",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "cee3l7v6urpj4f" },
      "targets": [{
        "refId": "A",
        "legendFormat": "{{instance}}",
        "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node-exporter\"} / node_memory_MemTotal_bytes{job=\"node-exporter\"})"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "cee3l7v6urpj4f" },
      "targets": [{
        "refId": "A",
        "legendFormat": "{{instance}}",
        "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[5m])) * 100)"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "PHP-FPM listen queue",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "cee3l7v6urpj4f" },
      "targets": [{
        "refId": "A",
        "legendFormat": "{{instance}} {{pool}}",
        "expr": "phpfpm_listen_queue > 0"
      }],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "PHP-FPM active workers",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "cee3l7v6urpj4f" },
      "targets": [{
        "refId": "A",
        "legendFormat": "{{instance}} {{pool}}",
        "expr": "topk(15, phpfpm_active_processes)"
      }],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] }
    }
  ]
}
